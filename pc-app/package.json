{
  "name": "nudge-screen-pc",
  "version": "0.1.0",
  "private": true,
  "description": "Windows companion app for Nudge Screen todos",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . \"Nudge Screen PC\" --platform=win32 --arch=x64 --out=dist --overwrite --icon=assets/icon.ico",
    "build:installer": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.wns544.nudgescreen.pc",
    "productName": "잠깐 할 일 PC",
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "files": [
      "assets/**/*",
      "src/**/*",
      "package.json"
    ]
  }
}
